---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const years = [...new Set(posts.map((post) => post.data.date.getUTCFullYear()))];
const monthDay = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<BaseLayout>
  <h1>Writing</h1>
  <div class="archive">
    {years.map((year) => (
      <section class="year-group" aria-labelledby={`year-${year}`}>
        <h2 id={`year-${year}`}>{year}</h2>
        <ol class="post-list">
          {posts.filter((post) => post.data.date.getUTCFullYear() === year).map((post) => (
            <li>
              <a href={`/writing/${post.id}/`}>
                <span class="post-title">{post.data.title}{post.data.sample && <span class="sample-tag">Sample</span>}</span>
                <time datetime={post.data.date.toISOString()}>{monthDay.format(post.data.date)}</time>
              </a>
              {post.data.description && <p>{post.data.description}</p>}
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</BaseLayout>
